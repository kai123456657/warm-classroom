# ============================================================
# 暖课堂 · 数据源配置
# 复制本文件为 .env.local 后按需修改
# ============================================================

# 数据源：local = 浏览器 localStorage（默认，纯前端演示）
#         http  = 连接真实 Flask 后端（需配合 VITE_API_BASE_URL）
VITE_DATA_SOURCE=local

# 后端 API 根地址（VITE_DATA_SOURCE=http 时生效）
# 本地 Flask 示例：http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
